{
  "$description": "Tipsarr mobile design tokens. Source of truth for the apps; mirrors the Penpot token sets core / light / dark (file Tipsarr). Neutral palette = the web theme, status colours = the web status colours.",
  "color": {
    "$type": "color",
    "light": {
      "bg": { "$value": "#FFFFFF" },
      "fg": { "$value": "#0A0A0A" },
      "card": { "$value": "#FFFFFF" },
      "muted": { "$value": "#F5F5F5" },
      "mutedFg": { "$value": "#737373" },
      "border": { "$value": "#E5E5E5" },
      "primary": { "$value": "#171717" },
      "primaryFg": { "$value": "#FAFAFA" },
      "destructive": { "$value": "#E7000B" },
      "ring": { "$value": "#A3A3A3" },
      "overlay": { "$value": "#00000066" }
    },
    "dark": {
      "bg": { "$value": "#0A0A0A" },
      "fg": { "$value": "#FAFAFA" },
      "card": { "$value": "#171717" },
      "muted": { "$value": "#262626" },
      "mutedFg": { "$value": "#A3A3A3" },
      "border": { "$value": "#FFFFFF1A" },
      "primary": { "$value": "#E5E5E5" },
      "primaryFg": { "$value": "#171717" },
      "destructive": { "$value": "#FF6467" },
      "ring": { "$value": "#737373" },
      "overlay": { "$value": "#000000A6" }
    },
    "status": {
      "available": { "$value": "#10B981" },
      "partial": { "$value": "#14B8A6" },
      "requested": { "$value": "#F59E0B" },
      "approved": { "$value": "#0EA5E9" },
      "searching": { "$value": "#D946EF" },
      "downloading": { "$value": "#6366F1" },
      "declined": { "$value": "#F43F5E" },
      "failed": { "$value": "#EA580C" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": 4 }, "sm": { "$value": 8 }, "md": { "$value": 12 }, "lg": { "$value": 16 },
    "xl": { "$value": 20 }, "2xl": { "$value": 24 }, "3xl": { "$value": 32 }, "4xl": { "$value": 48 }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": 8 }, "md": { "$value": 12 }, "lg": { "$value": 16 }, "xl": { "$value": 20 },
    "sheet": { "$value": 28 }, "full": { "$value": 999 }
  },
  "fontSize": {
    "$type": "dimension",
    "largeTitle": { "$value": 34 }, "title1": { "$value": 28 }, "title2": { "$value": 22 }, "title3": { "$value": 20 },
    "headline": { "$value": 17 }, "body": { "$value": 17 }, "callout": { "$value": 16 }, "subhead": { "$value": 15 },
    "footnote": { "$value": 13 }, "caption": { "$value": 12 }
  },
  "fontWeight": {
    "$type": "number",
    "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": 44 },
    "tabBarHeight": { "$value": 64 },
    "posterRatio": { "$value": 1.5, "$description": "poster height / width (2:3)" }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": 0.15 }, "normal": { "$value": 0.25 }, "slow": { "$value": 0.4 }
  }
}
