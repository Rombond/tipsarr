<?xml version="1.0" encoding="utf-8"?>
<!-- Strings are looked up by their generated name (Context.stringByName, ApiError, ServerMessage: perm_*, error_*, ...),
     which the release resource shrinker cannot see. Keep them all: without this the release build showed empty
     permission labels and raw error codes. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@string/*" />
