    "banner.dry_run_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are recorded and move through approval, but nothing is sent to Radarr or Sonarr. Set TIPSARR_DRY_RUN=false to go live."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes sont enregistrées et suivent l’approbation, mais rien n’est envoyé à Radarr ni Sonarr. Définissez TIPSARR_DRY_RUN=false pour passer en réel."
          }
        }
      }
    },
