    "stats.plugin_step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Jellyfin: Dashboard → Plugins → Catalog → Playback Reporting → Install, then restart Jellyfin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Jellyfin : Tableau de bord → Plugins → Catalogue → Playback Reporting → Installer, puis redémarrez Jellyfin."
          }
        }
      }
    },
    "stats.plugin_step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch something (the plugin records plays from then on)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez quelque chose (le plugin enregistre les lectures à partir de là)."
          }
        }
      }
    },
    "stats.plugin_step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipsarr finds the plugin by itself within the hour. Or run “Playback sync” in Settings → Jobs & hooks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipsarr trouve le plugin tout seul dans l’heure. Ou lancez « Synchro des lectures » dans Réglages → Tâches & hooks."
          }
        }
      }
    },
    "stats.plugin_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you, as an admin, see this. Tipsarr can import Jellyfin’s Playback Reporting plugin: real watch time, per month, weekday and hour, instead of estimates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les admins voient ce message. Tipsarr peut importer le plugin Playback Reporting de Jellyfin : temps réel regardé, par mois, jour de la semaine et heure, au lieu d’estimations."
          }
        }
      }
    },
    "stats.plugin_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want exact watch time and timelines?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie du temps de visionnage exact et de graphiques dans le temps ?"
