# BoxArr API (no auth required)
VITE_BOXARR_URL=http://localhost:8080/api

# SuggestArr API (JWT auth via cookie)
# Requires ALLOW_REGISTRATION=true on the SuggestArr backend so the app can
# auto-provision an account on first login with a user's Jellyfin credentials.
VITE_SUGGESTARR_URL=http://localhost:8080/api

# Radarr API (LAN-only; API key ships in built JS bundle — full Radarr admin access)
VITE_RADARR_URL=http://localhost:7878
VITE_RADARR_API_KEY=

# TMDB API (fallback poster lookup when Radarr has no match; LAN-only, key ships in bundle)
VITE_TMDB_API_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/original
VITE_TMDB_API_KEY=

# Seerr API (Jellyseerr/Overseerr; session-cookie auth via Jellyfin login — Seerr must
# already have a Jellyfin server configured under Settings > Jellyfin)
VITE_SEERR_URL=http://localhost:5055
